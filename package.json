{
  "name": "saywide",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @saywide/frontend dev",
    "build": "corepack pnpm --filter @saywide/frontend build",
    "start": "corepack pnpm --filter @saywide/frontend start",
    "lint": "corepack pnpm --filter @saywide/frontend lint",
    "test": "corepack pnpm --filter @saywide/frontend test",
    "typecheck": "corepack pnpm --filter @saywide/contracts typecheck && corepack pnpm --filter @saywide/frontend typecheck"
  }
}
