NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgres://saywide:saywide_dev@127.0.0.1:5433/saywide
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
TOKEN_DERIVATION_SECRET=replace-with-at-least-32-random-characters
GUEST_CREDENTIAL_DAYS=365
RESPONSE_SESSION_MINUTES=60
MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-luna
REPORT_MAX_RESPONSES=30
# Required only when MODEL_PROVIDER=openai. Keep this backend-only.
OPENAI_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Local development only. Omit this in Railway and provide runtime AWS credentials.
# AWS credentials remain required for Transcribe even when OpenAI is the model provider.
AWS_PROFILE=saywide.com
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_SIGNED_URL_SECONDS=60
TRANSCRIBE_RECORDING_LIMIT_SECONDS=120
LOG_LEVEL=info
